#!/usr/bin/env python3
# ── armojidots-hypr · HDR panel ─────────────────────────────────────
# Small standalone settings window for DP-2's HDR/color-management. Not a
# resident daemon like osd/spotlight/dock — this is opened rarely (via
# spotlight's /set > HDR, or hdr-panel.sh), so a plain launch-per-use
# Gtk.Application is simpler than the socket/--daemon plumbing those use.
#
# Owns two files:
#   ~/.local/state/armojidots-hypr/hdr.json   the actual state (source of
#                                              truth this app reads/writes)
#   ~/.config/hypr/monitor-dp2.lua            regenerated from that state on
#                                              every change, dofile'd by
#                                              hyprland.lua's MONITORS section
#                                              (same pattern as theme.sh's
#                                              colors.lua) + `hyprctl reload`
#
# DP-2's base geometry (mode/position/scale) is NOT reconfigurable here —
# hardcoded below to match hyprland.lua, since hl.monitor() rewrites the
# whole rule each call and there's no separate merge step. If you ever
# change DP-2's mode/position/scale in hyprland.lua, update GEOMETRY here
# too, or a later HDR-panel change would silently reset it back.
#
# cm/sdrbrightness/sdrsaturation/bitdepth semantics: see Hyprland wiki's
# Monitors page. Turning HDR on also switches bitdepth 8->10 (real HDR needs
# it to avoid banding) — the one caveat worth knowing is some screen-capture
# tools don't support 10-bit surfaces.

import gi, json, os, sys
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk, Gio, GLib

APP_ID = "org.armojidots.HDR"
CONFIG = os.path.expanduser("~/.config/armoji-hdr")
STATE_PATH = os.path.expanduser("~/.local/state/armojidots-hypr/hdr.json")
MONITOR_LUA = os.path.expanduser("~/.config/hypr/monitor-dp2.lua")

GEOMETRY = {"output": "DP-2", "mode": "2560x1440@240", "position": "1080x0", "scale": 1}

# max_luminance/max_avg_luminance default to this panel's actual VESA
# DisplayHDR True Black 400 certified figures (1000 nits peak @ 3% APL,
# 450 nits sustained @ 10% APL) rather than a guess or Hyprland's -1/auto —
# real published numbers beat an eyeballed test pattern. min_luminance is
# left on auto (-1): True Black 400 already implies near-zero blacks and
# there's no reliable published figure to default it to.
# sdr_eotf controls how SDR content (which is essentially everything —
# waybar, terminals, browsers; almost nothing emits true HDR-tagged pixels)
# gets interpreted when composited into HDR output. Confirmed live: with it
# left on "default" (follows Hyprland's global render:cm_sdr_eotf), waybar's
# nested translucent pills lost contrast against each other under HDR vs how
# they look in SDR — "srgb" is the fix Hyprland's own HDR bug reports point
# at for this exact symptom.
DEFAULTS = {
    "hdr": False,
    "sdr_eotf": "srgb",
    "sdrbrightness": 1.0,
    "sdrsaturation": 1.0,
    "max_luminance": 1000,
    "max_avg_luminance": 450,
}
APPLY_DEBOUNCE_MS = 200


def load_state():
    try:
        with open(STATE_PATH) as f:
            d = json.load(f)
        return {**DEFAULTS, **d}
    except (OSError, ValueError):
        return dict(DEFAULTS)


def write_monitor_lua(state):
    cm = "hdr" if state["hdr"] else "srgb"
    # Always 10-bit, independent of the force-HDR toggle. Confirmed live:
    # render:cm_auto_hdr (Hyprland's automatic fullscreen-HDR promotion,
    # on by default) only switches the `cm` field for a fullscreen HDR
    # game — it does NOT also bump bitdepth. Leaving this tied to the
    # toggle meant BeamNG.drive's in-game HDR got auto-promoted to cm=hdr
    # but the connector was still stuck at 8-bit ("HDR on but no 10-bit"
    # warning in-game). bitdepth=10 alone (with cm still "srgb" day to
    # day) doesn't force the HDR tone-mapping pipeline that caused the
    # waybar contrast issue — only `cm=hdr` does that — so this is safe to
    # leave on permanently.
    bitdepth = 10
    lua = (
        "-- generated by armoji-hdr — DP-2 monitor rule "
        "(geometry + HDR/color management)\n"
        "hl.monitor({\n"
        f'  output = "{GEOMETRY["output"]}",\n'
        f'  mode = "{GEOMETRY["mode"]}",\n'
        f'  position = "{GEOMETRY["position"]}",\n'
        f'  scale = {GEOMETRY["scale"]},\n'
        f'  cm = "{cm}",\n'
        f"  bitdepth = {bitdepth},\n"
        f'  sdr_eotf = "{state["sdr_eotf"]}",\n'
        f'  sdrbrightness = {state["sdrbrightness"]:.2f},\n'
        f'  sdrsaturation = {state["sdrsaturation"]:.2f},\n'
        f'  max_luminance = {int(state["max_luminance"])},\n'
        f'  max_avg_luminance = {int(state["max_avg_luminance"])},\n'
        "})\n"
    )
    os.makedirs(os.path.dirname(MONITOR_LUA), exist_ok=True)
    with open(MONITOR_LUA, "w") as f:
        f.write(lua)


def apply_state(state):
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    with open(STATE_PATH, "w") as f:
        json.dump(state, f)
    write_monitor_lua(state)
    GLib.spawn_command_line_async("hyprctl reload")


class HDRPanel(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.state = load_state()
        self._apply_src = 0

    def do_activate(self):
        self.load_css()
        win = Gtk.ApplicationWindow(application=self)
        win.set_title("HDR & Display")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_default_size(360, -1)
        win.add_css_class("hdr-panel")

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        outer.add_css_class("panel")
        win.set_child(outer)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        title = Gtk.Label(label="HDR & Display", xalign=0, hexpand=True)
        title.add_css_class("title")
        header.append(title)
        close_btn = Gtk.Button(label="×")
        close_btn.add_css_class("close-btn")
        close_btn.connect("clicked", lambda *_: win.close())
        header.append(close_btn)
        outer.append(header)

        auto_note = Gtk.Label(
            label="Fullscreen HDR games/video already switch to real HDR\n"
                  "automatically (Hyprland's render:cm_auto_hdr, on by\n"
                  "default) — nothing below is needed for that. The\n"
                  "connector runs 10-bit at all times so those switches\n"
                  "actually deliver real HDR instead of clipping to 8-bit\n"
                  "(some screen-capture tools don't support 10-bit).",
            xalign=0, wrap=True)
        auto_note.add_css_class("note")
        outer.append(auto_note)

        # ── force-HDR switch ──
        hdr_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hdr_label = Gtk.Label(label="Force HDR always (DP-2)", xalign=0, hexpand=True)
        hdr_label.add_css_class("row-label")
        hdr_row.append(hdr_label)
        self.hdr_switch = Gtk.Switch()
        self.hdr_switch.set_valign(Gtk.Align.CENTER)
        self.hdr_switch.set_active(self.state["hdr"])
        hdr_row.append(self.hdr_switch)
        outer.append(hdr_row)

        note = Gtk.Label(
            label="Puts the WHOLE desktop through HDR tone-mapping, not\n"
                  "just fullscreen content — waybar/GTK apps can look off\n"
                  "(confirmed: contrast between waybar's nested pills\n"
                  "collapses). Leave off unless you have a specific reason\n"
                  "to want desktop-wide HDR.",
            xalign=0, wrap=True)
        note.add_css_class("note")
        outer.append(note)

        # ── SDR brightness ──
        self.brightness_scale, brightness_box = self._slider_row(
            "SDR Brightness", 1.0, 2.0, 0.05, self.state["sdrbrightness"])
        outer.append(brightness_box)

        # ── SDR saturation ──
        self.saturation_scale, saturation_box = self._slider_row(
            "SDR Saturation", 0.5, 1.5, 0.05, self.state["sdrsaturation"])
        outer.append(saturation_box)

        calib_note = Gtk.Label(
            label="Peak/Sustained default to this panel's certified VESA\n"
                  "DisplayHDR True Black 400 spec (1000/450 nits). Nudge by\n"
                  "feel while watching real HDR content if it looks off —\n"
                  "there's no way to render a scientifically nit-accurate\n"
                  "test pattern from a plain app window.",
            xalign=0, wrap=True)
        calib_note.add_css_class("note")
        outer.append(calib_note)

        # ── peak luminance ──
        self.peak_scale, peak_box = self._slider_row(
            "Peak Brightness (nits, ~3% of screen)", 100, 2000, 10,
            self.state["max_luminance"], digits=0)
        outer.append(peak_box)

        # ── sustained (full-frame) luminance ──
        self.sustained_scale, sustained_box = self._slider_row(
            "Sustained Brightness (nits, ~10% of screen)", 100, 1000, 10,
            self.state["max_avg_luminance"], digits=0)
        outer.append(sustained_box)

        self._set_sliders_sensitive(self.state["hdr"])

        # connect signals AFTER setting initial values, so loading state
        # doesn't itself trigger an apply/reload
        self.hdr_switch.connect("notify::active", self.on_hdr_toggled)
        self.brightness_scale.connect("value-changed", self.on_slider_changed)
        self.saturation_scale.connect("value-changed", self.on_slider_changed)
        self.peak_scale.connect("value-changed", self.on_slider_changed)
        self.sustained_scale.connect("value-changed", self.on_slider_changed)

        win.present()

    def _slider_row(self, label_text, lo, hi, step, value, digits=2):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        label = Gtk.Label(label=label_text, xalign=0)
        label.add_css_class("row-label")
        box.append(label)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        scale.set_value(value)
        scale.set_draw_value(True)
        scale.set_digits(digits)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.add_css_class("slider")
        box.append(scale)
        return scale, box

    def _set_sliders_sensitive(self, on):
        self.brightness_scale.set_sensitive(on)
        self.saturation_scale.set_sensitive(on)
        self.peak_scale.set_sensitive(on)
        self.sustained_scale.set_sensitive(on)

    def on_key(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.get_active_window().close()
            return True
        return False

    def on_hdr_toggled(self, switch, _pspec):
        self.state["hdr"] = switch.get_active()
        self._set_sliders_sensitive(self.state["hdr"])
        self.schedule_apply()

    def on_slider_changed(self, scale):
        self.state["sdrbrightness"] = self.brightness_scale.get_value()
        self.state["sdrsaturation"] = self.saturation_scale.get_value()
        self.state["max_luminance"] = self.peak_scale.get_value()
        self.state["max_avg_luminance"] = self.sustained_scale.get_value()
        self.schedule_apply()

    def schedule_apply(self):
        # debounced — dragging a slider fires value-changed continuously,
        # and each apply is a file write + hyprctl reload
        if self._apply_src:
            GLib.source_remove(self._apply_src)
        self._apply_src = GLib.timeout_add(APPLY_DEBOUNCE_MS, self._do_apply)

    def _do_apply(self):
        self._apply_src = 0
        apply_state(self.state)
        return False

    def load_css(self):
        display = Gdk.Display.get_default()
        for fname, prio in (("colors.css", Gtk.STYLE_PROVIDER_PRIORITY_USER),
                            ("style.css", Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)):
            path = os.path.join(CONFIG, fname)
            if not os.path.exists(path):
                continue
            p = Gtk.CssProvider()
            p.load_from_path(path)
            Gtk.StyleContext.add_provider_for_display(display, p, prio)


if __name__ == "__main__":
    sys.exit(HDRPanel().run(sys.argv))
